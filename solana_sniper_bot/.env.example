# Solana RPC Configuration
# Use your own RPC endpoints for production!
# Free public endpoints have rate limits and are not suitable for sniper bots

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# Recommended: Premium RPC providers (uncomment and configure)
# QUICKNODE_URL=https://your-quicknode-endpoint.quiknode.pro
# HELIUS_URL=https://mainnet.helius-rpc.com/?api-key=your-api-key
# TRITON_URL=https://your-triton-endpoint.rpcpool.com

# Wallet Configuration
# ⚠️ IMPORTANT: Never commit your private key to version control!
# Use a dedicated trading wallet with limited funds only
WALLET_PRIVATE_KEY=

# Trading Parameters
BUY_AMOUNT_SOL=0.1
MAX_SLIPPAGE_BPS=500
PRIORITY_FEE_LAMPORTS=100000

# Security & Risk Management
MIN_LIQUIDITY_SOL=1000
MAX_LIQUIDITY_SOL=100000
MAX_LOSS_PER_TOKEN_SOL=0.05
DAILY_LOSS_LIMIT_SOL=1.0

# Token Safety Checks
CHECK_MINT_AUTHORITY=true
CHECK_FREEZE_AUTHORITY=true
MIN_HOLDERS=10
MAX_TOP_HOLDER_PERCENT=30

# DEX Configuration
MONITOR_RAYDIUM=true
MONITOR_ORCA=true
MONITOR_PUMPFUN=true

# Advanced Features
ENABLE_JITO=false
JITO_AUTH_KEYPAIR=
ENABLE_AUTO_SELL=true
TAKE_PROFIT_PERCENT=100
STOP_LOSS_PERCENT=50

# Bot Settings
DRY_RUN=true
LOG_LEVEL=INFO
